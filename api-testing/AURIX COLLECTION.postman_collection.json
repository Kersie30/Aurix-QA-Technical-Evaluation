      "name": "Auth login",
      "item": [
        {
          "name": "login page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Get the full HTML response from the AURIX login page\r\nconst html = pm.response.text();\r\n\r\n// Find the CSRF token inside the hidden input field\r\nconst match = html.match(\r\n    /name=[\"']csrf_token[\"'][^>]*value=[\"']([^\"']+)[\"']/\r\n);\r\n\r\n// Check whether the token was found\r\nif (match && match[1]) {\r\n\r\n    // Save the CSRF token as a collection variable\r\n    pm.collectionVariables.set(\"csrf_token\", match[1]);\r\n\r\n    // Confirmation in Postman Console\r\n    console.log(\"CSRF token captured successfully.\");\r\n\r\n    // Optional test so the request clearly shows as passed\r\n    pm.test(\"CSRF token captured\", function () {\r\n        pm.expect(match[1]).to.be.a(\"string\").and.not.empty;\r\n    });\r\n\r\n} else {\r\n\r\n    // Clear old value in case token capture failed\r\n    pm.collectionVariables.unset(\"csrf_token\");\r\n\r\n    console.log(\"CSRF token was not found in the response.\");\r\n\r\n    // Fail the test so you know something went wrong\r\n    pm.test(\"CSRF token should be present\", function () {\r\n        pm.expect.fail(\"CSRF token not found in login page HTML.\");\r\n    });\r\n}\r\n\r\n// Confirm that GET login page responded successfully\r\npm.test(\"Login page returned HTTP 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// Confirm that the response is HTML\r\npm.test(\"Response contains login page HTML\", function () {\r\n    pm.expect(html.toLowerCase()).to.include(\"<html\");\r\n});"
                ]
              }
            }
          ],
